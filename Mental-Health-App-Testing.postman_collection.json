      "name": "AUTH - Logins",
      "item": [
        {
          "name": "Registro Usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.globals.set('token-usuario', jsonData.token);",
                  "    pm.globals.set('usuarioId', jsonData.usuario?.id);",
                  "    console.log('✅ Registro exitoso. Token Usuario guardado: ' + jsonData.token.substring(0,20) + '...');",
                  "} else {",
                  "    console.log('ℹ️ Registro completado (sin auto-login o revisa respuesta):', jsonData);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Samuel\",\n  \"apellidos\": \"León\",\n  \"correo\": \"samuel.leon@test.com\",\n  \"contrasena\": \"12345678\",\n  \"telefono\": \"1111111\",\n  \"ciudad\": \"UniLibre\",\n  \"edad\": 20\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "register"]
            }
          }
        },
