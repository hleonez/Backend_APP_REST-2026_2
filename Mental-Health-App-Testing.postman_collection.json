    {
      "name": "FASE 8 — CONFIGURACIÓN Y PRUEBAS",
      "description": "Flujos de prueba de Fase 8: microservicio de sentimiento, chatbot con sentimiento persistido, onboarding y encuesta adaptativa. Ejecutar antes la carpeta AUTH - Logins para poblar las variables {{token-usuario}} y {{usuarioId}}.",
      "item": [
        {
          "name": "1. SENTIMENT — INICIO / VERIFICACIÓN",
          "item": [
            {
              "name": "1.1 SENTIMENT - Health (GET /health)",
              "request": {
                "method": "GET",
                "description": "Verifica que el microservicio de sentimiento (FastAPI en sentiment/, puerto 8000) esté activo.\n\nLevantarlo (override de desarrollo que expone el puerto 8000):\n  docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build sentiment\n\nRespuesta esperada (200):\n  {\"status\":\"ok\"}",
                "url": {
                  "raw": "http://localhost:8000/health",
                  "protocol": "http",
                  "host": ["localhost"],
                  "port": "8000",
                  "path": ["health"]
                }
              }
            },
            {
              "name": "1.2 SENTIMENT - Analyze (POST /analyze)",
              "request": {
                "method": "POST",
                "header": [
                  {"key": "Content-Type", "value": "application/json"}
                ],
                "description": "Prueba el encoder de sentimiento (pysentimiento/RoBERTuito, sentiment/app/main.py).\n\nRespuesta esperada (200):\n  {\"label\":\"NEG|NEU|POS\",\"scores\":{\"NEG\":0.97,\"NEU\":0.02,\"POS\":0.01}}\n\nSi el modelo aún no termina de cargar responde 503 {\"detail\":\"Modelo aún no disponible\"}.",
                "body": {
                  "mode": "raw",
                  "raw": "{\"texto\":\"Hoy me fue súper mal en el parcial\"}"
                },
                "url": {
                  "raw": "http://localhost:8000/analyze",
                  "protocol": "http",
                  "host": ["localhost"],
                  "port": "8000",
                  "path": ["analyze"]
                }
              }
            }
          ]
        },
        {
          "name": "2. CHATBOT + SENTIMIENTO PERSISTIDO",
          "item": [
            {
              "name": "2.1 POST /api/chats/ia (Chatbot con sentimiento persistido)",
              "event": [
                {
                  "listen": "test",
